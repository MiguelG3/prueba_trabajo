# ─────────────────────────────────────────────────────────────────────────────
# Modelo de lenguaje — elige UN bloque. Cambiar de proveedor no toca código.
# La llave solo vive aquí (o en los secrets de Render); nunca en el repo ni el front.
# ─────────────────────────────────────────────────────────────────────────────

# ── GRATIS ───────────────────────────────────────────────────────────────────
# Google Gemini (por defecto). Llave gratis y sin tarjeta: https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
LLM_API_KEY=
# LLM_MODEL=gemini-flash-latest          # o gemini-2.5-flash, gemini-2.5-pro...

# Groq. Llave gratis: https://console.groq.com/keys
# LLM_PROVIDER=groq
# LLM_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile

# OpenRouter (modelos con sufijo :free). Llave gratis: https://openrouter.ai/keys
# LLM_PROVIDER=openrouter
# LLM_API_KEY=
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Ollama local, sin llave (solo en local, no en Render): ollama pull qwen2.5:7b
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:7b

# ── DE PAGO ──────────────────────────────────────────────────────────────────
# Anthropic Claude
# LLM_PROVIDER=anthropic
# LLM_API_KEY=
# LLM_MODEL=claude-opus-5-5              # o claude-sonnet-5-5 / claude-haiku-5-5
# LLM_EFFORT=medium                      # low | medium | high | xhigh | max
# LLM_ANTHROPIC_FALLBACK=true            # fallback server-side ante rechazos de seguridad

# OpenAI
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_MODEL=gpt-4.1-mini

# Cualquier endpoint compatible con OpenAI (Azure OpenAI, Mistral, Together, vLLM...)
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://mi-endpoint/v1
# LLM_API_KEY=
# LLM_MODEL=mi-modelo

# ── Opcionales ───────────────────────────────────────────────────────────────
# LLM_TEMPERATURE=                       # solo OpenAI-compatibles; Claude actual la rechaza
# LLM_TIMEOUT_S=60
# LLM_MAX_RETRIES=3                      # backoff ante 429 (útil con free tiers)
# MAX_ITERACIONES=25                     # tope herramienta→modelo por turno
# MAX_TOKENS_SESION=300000               # tope de tokens por sesión
# MAX_TOKENS_GLOBAL=3000000              # tope de tokens del proceso
# APP_ACCESS_KEY=                        # si se define, el front debe enviarla (protege la llave)
# FECHA_REFERENCIA=2026-09-03            # fija la fecha_registro para demos deterministas
# PORT=8000
